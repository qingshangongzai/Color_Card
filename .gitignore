# ============================================================
# 取色卡 (Color Card) Git 忽略规则
# 只保留结构性规则，不为单个临时文件添加条目
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*.so
.venv/
venv/
env/
ENV/

# ---------- 测试与静态检查 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
bandit_report*.html

# ---------- 构建与打包产物 ----------
# CI 打包时生成的构建号文件
/build_info.py
/build/
/dist/
/output/
_nuitka_cache/
*.build/
*.dist/
*.onefile-build/
*.spec
*.exe
*.app/
*.dmg
/upx/
upx-*.zip
/打包/

# ---------- 运行日志 ----------
/logs/
*.log

# ---------- AI 工具与 IDE 工作目录 ----------
# 根目录 skills/ 为唯一维护源，各工具下的副本不单独维护
/.trae/
/.qoder/
/.arts/
/.zcode/
/.codebuddy/
/.idea/
/.vscode/
*.swp
*~

# ---------- 网站 (Vite) ----------
node_modules/
/website/dist/

# ---------- 操作系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 项目私有文件 ----------
# 过程性文档（方案/计划/分析类）整体不入库
/文档/过程性文档/
# 本地演示脚本与测试图片素材，不入库
/demo/
/测试图片/
# 应用导出的配色文件与色卡图片
color_card_*.json
color_card_favorites.json
色彩提取色卡_*.png
PixPin_*.png
# 临时文件
*.tmp
~$*
